# Copy to deploy/.env and fill in. Keep the real file out of git; on a cloud host load it from the
# provider's secret store. Start the stack with:
#   docker compose -f docker-compose.yml --env-file .env up -d --build

# Base domain. The TURN server is at turn.<DOMAIN>. Point a DNS A record for turn.<DOMAIN>
# at this server's public IP.
DOMAIN=layyahgroup.com

# The dashboard's full hostname (its own DNS A record -> this server's public IP).
# The dashboard is served at  https://<DASHBOARD_HOST>
DASHBOARD_HOST=dashboard.layyahgroup.com

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@layyahgroup.com

# This server's PUBLIC IP. coturn advertises it, and the dashboard/API are also reachable
# directly at  http://<PUBLIC_IP>  (plain HTTP) in addition to the HTTPS domain.
PUBLIC_IP=203.0.113.10

# Cookies: false lets you log in over plain HTTP by IP too. Set "true" to require the HTTPS
# domain only (more secure, but then http://<IP> login will not work).
COOKIE_SECURE=false

# Database password — generate:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-long-random

# Shared TURN secret — generate:  openssl rand -hex 24
TURN_SECRET=change-me-long-random

# Optional Telegram alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
