# Copy to deploy/.env and fill in. Keep the real file out of git; on EC2 load it from SSM/Secrets Manager.
DOMAIN=example.com
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=change-me-long-random

# Shared between api (signs TURN credentials) and coturn (checks them).
TURN_SECRET=change-me-long-random
# EC2 Elastic IP; coturn advertises it to clients.
PUBLIC_IP=203.0.113.10

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
