# Production settings. Copy to deploy/.env and fill in; keep the real file out of git.
#   cd deploy && docker compose -f docker-compose.yml --env-file .env up -d --build
#
# The dashboard is served over HTTPS on DASHBOARD_HOST (point its DNS A record at this server).
# Phones can pair to https://<DASHBOARD_HOST> (recommended: encrypted) or http://<PUBLIC_IP>.

# Dashboard hostname. Caddy gets a Let's Encrypt certificate for it automatically.
DASHBOARD_HOST=dashboard.example.com

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.com

# This server's public IP. The video relay (TURN) advertises it; the dashboard/API also answer
# on http://<PUBLIC_IP>.
PUBLIC_IP=203.0.113.10

# false lets you sign in over plain HTTP by IP too. "true" = HTTPS domain only (more secure).
COOKIE_SECURE=false

# Admins and superusers must turn on two-factor login. Set false only to recover access.
REQUIRE_ADMIN_2FA=true

# Generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-long-random
TURN_SECRET=change-me-long-random

# Optional Telegram alerts (phone offline, stuck at 1 fps, low battery, no data). Blank = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
