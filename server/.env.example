# Local development (cp .env.example .env). Production values come from deploy/docker-compose.yml.
MT5_DATABASE_URL=postgresql+asyncpg://mt5:mt5@127.0.0.1:5432/mt5
MT5_REDIS_URL=redis://127.0.0.1:6379/0
# The Vite dev server's origin, so the operator WebSocket Origin check passes.
MT5_PUBLIC_URL=http://localhost:5173
MT5_COOKIE_SECURE=false
MT5_TURN_SECRET=dev-secret
MT5_TURN_URLS=["turn:127.0.0.1:3478?transport=udp"]
